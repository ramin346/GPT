# ── ربات تلگرام ──
BOT_TOKEN=
# آیدی عددی ادمین‌ها با کاما جدا شود (از @userinfobot بگیر)
ADMIN_IDS=123456789

# ── API تأمین‌کننده (کلید فقط اینجا، نه در کد) ──
API_BASE=https://canboso.com/api/v2/telegram-buyer
API_KEY=
AUTH_HEADER=Authorization
AUTH_PREFIX=Bearer 

# ── قیمت‌گذاری ──
# اگر قیمت API دلاری است نرخ دلار را بگذار، اگر تومان است 1
PRICE_MULTIPLIER=1
DEFAULT_MARKUP=20
CURRENCY=تومان

# ── اطلاعات کارت برای شارژ کیف پول ──
CARD_NUMBER=6037-0000-0000-0000
CARD_OWNER=نام صاحب کارت
SUPPORT=@your_support

# ── آپدیت خودکار از گیت‌هاب ──
# هر چند دقیقه یک‌بار چک شود (0 = خاموش)
AUTO_UPDATE_MINUTES=10
GIT_BRANCH=main
