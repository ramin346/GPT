# ── ربات تلگرام ──
BOT_TOKEN=
# آیدی عددی ادمین‌ها با کاما جدا شود (از @userinfobot بگیر)
ADMIN_IDS=123456789

# ── مقدار اولیه‌ی کارت (بعداً از داخل ربات قابل تغییر است: پنل ادمین ← درگاه‌های پرداخت) ──
CARD_NUMBER=6037-0000-0000-0000
CARD_OWNER=نام صاحب کارت
SUPPORT=@your_support
CURRENCY=تومان

# ── هشدار کمبود موجودی ──
# وقتی موجودی یک محصول کمتر یا مساوی این عدد شد، به ادمین پیام می‌آید
LOW_STOCK=3

# ── آپدیت خودکار از گیت‌هاب ──
# هر چند دقیقه یک‌بار چک شود (0 = خاموش)
AUTO_UPDATE_MINUTES=10
GIT_BRANCH=main

# ── NOWPayments (اختیاری) ──
# API Key و نرخ تتر را از داخل ربات تنظیم کن، نه اینجا.
# برای تست با محیط sandbox این خط را فعال کن:
# NOWPAYMENTS_API_BASE=https://api-sandbox.nowpayments.io/v1
